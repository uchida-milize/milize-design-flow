px\n    border-radius: 9999px\n    background-color: #EFF2F7\n    padding-left: 30px\n    padding-right: 30px\n  ★ .btn.btn-blue-outline（実際のボタン要素で2回使用）\n    display: flex\n    border-radius: 9999px\n    color: rgb(0 132 255/var(--tw-text-opacity))\n    --tw-ring-offset-shadow: var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color)\n    --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(1px + var(--tw-ring-offset-width)) var(--tw-ring-color)\n    box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000)\n  /*! This file is auto-generated */\n.wp-block-button__link\n    color: #fff\n    background-color: #32373c\n    border-radius: 9999px\n    box-shadow: none\n    padding: calc(.667em + 2px) calc(1.333em + 2px)\n  .primary-btn\n    display: flex\n    height: 65px\n    border-radius: 9999px\n    background-color: rgb(0 132 255/var(--tw-bg-opacity))\n    background-image: url(../img/global/noise.png)\n    padding-left: 30px\n  .secondary-btn\n    display: flex\n    height: 65px\n    border-radius: 9999px\n    background-color: rgb(239 242 247/var(--tw-bg-opacity))\n    padding-left: 30px\n    padding-right: 30px\n\n【カードスタイル】\n  /* Contact Card */\n.contact-card\n    background-color: white\n    border: 1px solid #E9E9E9\n    border-radius: 20px\n    padding: 30px 25px\n    color: #000\n    display: block\n  .contact-card:hover\n    border-color: transparent\n    box-shadow: 0 10px 25px rgba(0, 132, 255, 0.1)\n    background: linear-gradient(to top right, #0084ff, #79beff)\n    color: white\n  .contact-card\n    padding: 40px 30px\n  .contact-card:hover h3\n    color: white\n  .contact-card:hover p\n    color: rgba(255, 255, 255, 0.9)\n\n【フォームスタイル】\n  .wpcf7 input,\n.wpcf7 textarea,\n.wpcf7 button,\n.wpcf7 select\n    width: 100%\n    padding: 1em\n    border: 1px solid #aaa\n    border-radius: 4px\n    font-size: 16px\n  .wpcf7 form .wpcf7-response-output\n    margin: 2em 0.5em 1em\n    padding: 0.2em 1em\n 